              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Regenerate Reference",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{project_id}/dictation": {
      "post": {
        "description": "Transcribe a spoken edit instruction: a WAV body, mono 16-bit at 16 or 24 kHz, at most 30 s.\n\nReturns the text for the user to check; nothing is edited until they send it to .../panel/edit.",
        "operationId": "dictate_projects__project_id__dictation_post",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "audio/wav": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DictationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
